<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NMMail.Views.MessageListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NMMail.ViewModels"
    xmlns:h="using:NMMail.Helpers">

    <UserControl.Resources>
        <MenuFlyout x:Key="RowMenu">
            <MenuFlyoutItem x:Uid="Menu_Reply" Text="Rispondi" Click="MenuReply_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8CA;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="Menu_ReplyAll" Text="Rispondi a tutti" Click="MenuReplyAll_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C2;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="Menu_Forward" Text="Inoltra" Click="MenuForward_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE89C;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Uid="Menu_MarkRead" Text="Segna come letto" Click="MenuRead_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C3;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="Menu_MarkUnread" Text="Segna come non letto" Click="MenuUnread_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE715;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="Menu_Flag" Text="Contrassegna" Click="MenuFlag_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C1;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Uid="Menu_Archive" Text="Archivia" Click="MenuArchive_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="Menu_Delete" Text="Elimina" Click="MenuDelete_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSubItem x:Uid="Menu_MoveTo" Text="Sposta in">
                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8DE;" /></MenuFlyoutSubItem.Icon>
            </MenuFlyoutSubItem>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: folder name / search results -->
        <Grid Padding="16,10,8,6" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ListTitle, Mode=OneWay}" Style="{StaticResource PaneTitleTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ListSubtitle, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                           Visibility="{x:Bind h:Fmt.VisibleIfText(ViewModel.ListSubtitle), Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="ClearSearchButton" x:Uid="List_ClearSearch" Style="{StaticResource QuickActionButtonStyle}"
                        Width="34" Height="34" Click="ClearSearch_Click"
                        Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay}">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
                <ToggleButton x:Name="UnreadFilterButton" x:Uid="List_UnreadOnly" Width="34" Height="34" Padding="0"
                              Background="Transparent" BorderThickness="0"
                              IsChecked="{x:Bind ViewModel.UnreadOnly, Mode=TwoWay}"
                              Visibility="{x:Bind h:Fmt.Collapsed(ViewModel.IsSearchMode), Mode=OneWay}">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <ListView x:Name="MessageList" Grid.Row="1"
                  SelectionMode="Extended"
                  IsItemClickEnabled="False"
                  SelectionChanged="MessageList_SelectionChanged"
                  ContainerContentChanging="MessageList_ContainerContentChanging"
                  ShowsScrollingPlaceholders="False"
                  Padding="0,0,0,8">
            <ListView.Resources>
                <!-- The accent bar on the left means "unread": selection is shown by the background only. -->
                <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
            </ListView.Resources>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel AreStickyGroupHeadersEnabled="False" ItemsUpdatingScrollMode="KeepItemsInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="ListViewHeaderItem">
                            <Setter Property="MinHeight" Value="30" />
                            <Setter Property="Padding" Value="16,10,12,4" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:MessageGroup">
                            <TextBlock Text="{x:Bind Key}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="8,0,4,0" />
                    <Setter Property="Margin" Value="4,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageItem">
                    <Grid Padding="0,7,4,8" ColumnSpacing="10" RowSpacing="1" Background="Transparent"
                          PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited" PointerCanceled="Row_PointerExited"
                          ContextRequested="Row_ContextRequested">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Rectangle Grid.RowSpan="3" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="0,2"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsUnread, Mode=OneWay}" />

                        <Grid Grid.Column="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind AccountBrush}"
                                     Visibility="{x:Bind ShowAccount}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind SenderName, Mode=OneWay}" FontWeight="{x:Bind Weight, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </Grid>
                        <TextBlock Grid.Column="2" Text="{x:Bind TimeText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                   Visibility="{x:Bind h:Fmt.Collapsed(IsHovered), Mode=OneWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Subject, Mode=OneWay}" FontWeight="{x:Bind Weight, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    HorizontalAlignment="Right" Visibility="{x:Bind h:Fmt.Collapsed(IsHovered), Mode=OneWay}">
                            <FontIcon Glyph="&#xE723;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Visibility="{x:Bind HasAttachments, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE7C1;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                      Visibility="{x:Bind IsFlagged, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind Snippet, Mode=OneWay}"
                                   Style="{StaticResource SecondaryCaptionStyle}" FontSize="13" MaxLines="1" />

                        <!-- Hover quick actions (realized only while hovered) -->
                        <StackPanel x:Name="QuickActions" x:Load="{x:Bind IsHovered, Mode=OneWay}" Grid.Column="2" Grid.RowSpan="2"
                                    Orientation="Horizontal" Spacing="0" VerticalAlignment="Top" Margin="0,-4,0,0">
                            <Button x:Uid="Quick_Archive" Style="{StaticResource QuickActionButtonStyle}" Tag="{x:Bind}" Click="QuickArchive_Click">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                            </Button>
                            <Button x:Uid="Quick_Delete" Style="{StaticResource QuickActionButtonStyle}" Tag="{x:Bind}" Click="QuickDelete_Click">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                            <Button x:Uid="Quick_ToggleRead" Style="{StaticResource QuickActionButtonStyle}" Tag="{x:Bind}" Click="QuickRead_Click">
                                <FontIcon Glyph="{x:Bind h:Fmt.ReadToggleGlyph(IsUnread), Mode=OneWay}" FontSize="14" />
                            </Button>
                            <Button x:Uid="Quick_Flag" Style="{StaticResource QuickActionButtonStyle}" Tag="{x:Bind}" Click="QuickFlag_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xE7C1;" FontSize="14" Visibility="{x:Bind h:Fmt.Collapsed(IsFlagged), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE7C1;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                              Visibility="{x:Bind IsFlagged, Mode=OneWay}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Footer>
                <ProgressBar Margin="24,8" IsIndeterminate="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
            </ListView.Footer>
        </ListView>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="280" Margin="16"
                    Visibility="{x:Bind ViewModel.IsListEmpty, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind ViewModel.EmptyGlyph, Mode=OneWay}" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Uid="List_AddAccount" Content="Aggiungi un account" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.ShowAddAccountHint, Mode=OneWay}" Click="AddAccount_Click" />
        </StackPanel>

        <ProgressRing Grid.Row="1" Width="32" Height="32" IsActive="{x:Bind ViewModel.IsLoadingList, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoadingList, Mode=OneWay}" />
    </Grid>
</UserControl>
