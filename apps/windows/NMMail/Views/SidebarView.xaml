<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NMMail.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NMMail.ViewModels"
    xmlns:controls="using:NMMail.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="UnifiedTemplate" x:DataType="vm:SidebarItem">
            <Grid Height="36">
                <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                <Grid Padding="14,0,10,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontWeight="{x:Bind TitleWeight, Mode=OneWay}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <InfoBadge Grid.Column="2" Value="{x:Bind Unread, Mode=OneWay}" Visibility="{x:Bind HasUnread, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AccountTemplate" x:DataType="vm:SidebarItem">
            <Grid Padding="8,12,10,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="10" VerticalAlignment="Top" Margin="0,5,0,0"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Ellipse Grid.Column="1" Width="10" Height="10" Fill="{x:Bind AccountBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" MaxLines="1" />
                    <HyperlinkButton x:Uid="Sidebar_Reauth" Content="Accedi di nuovo" Padding="0,2" FontSize="12" Margin="0,2,0,0"
                                     Visibility="{x:Bind ShowReauth, Mode=OneWay}" Tag="{x:Bind}" Click="Reauth_Click" />
                </StackPanel>
                <Grid Grid.Column="3" Width="16" Height="16" VerticalAlignment="Top" Margin="0,3,0,0" Background="Transparent"
                      ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind StateGlyph, Mode=OneWay}" FontSize="{x:Bind StateGlyphSize, Mode=OneWay}"
                              Foreground="{x:Bind StateBrush, Mode=OneWay}" Visibility="{x:Bind ShowStateGlyph, Mode=OneWay}" />
                    <ProgressRing Width="14" Height="14" MinWidth="14" MinHeight="14" IsActive="{x:Bind IsConnecting, Mode=OneWay}"
                                  Visibility="{x:Bind IsConnecting, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FolderTemplate" x:DataType="vm:SidebarItem">
            <Grid Height="32">
                <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                <Grid Padding="{x:Bind Indent, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Width="18" Height="24" Padding="0" Background="Transparent" BorderThickness="0" IsTabStop="False"
                            Visibility="{x:Bind ChevronVisibility, Mode=OneWay}" Tag="{x:Bind}" Click="Chevron_Click">
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="15" Margin="2,0,10,0" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Title, Mode=OneWay}" FontWeight="{x:Bind TitleWeight, Mode=OneWay}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Grid.Column="3" Text="{x:Bind UnreadText, Mode=OneWay}" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <controls:SidebarTemplateSelector x:Key="SidebarSelector"
                                          UnifiedTemplate="{StaticResource UnifiedTemplate}"
                                          AccountTemplate="{StaticResource AccountTemplate}"
                                          FolderTemplate="{StaticResource FolderTemplate}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button x:Name="NewMailButton" x:Uid="Sidebar_NewMailButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                Margin="12,4,12,8" Padding="12,7" Click="NewMail_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
                <TextBlock x:Uid="Sidebar_NewMail" Text="Nuovo messaggio" />
            </StackPanel>
        </Button>

        <ListView x:Name="FolderList" Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.SidebarItems}"
                  ItemTemplateSelector="{StaticResource SidebarSelector}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="FolderList_ItemClick"
                  Padding="0,0,0,8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="6,0,4,0" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Button x:Name="SettingsButton" x:Uid="Sidebar_SettingsButton" Grid.Row="2" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left" Margin="8,4,8,8" Padding="12,8" Click="Settings_Click">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
                <TextBlock x:Uid="Sidebar_Settings" Text="Impostazioni" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
