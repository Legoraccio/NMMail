<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NMMail.Views.ReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NMMail.ViewModels"
    xmlns:h="using:NMMail.Helpers">

    <Grid>
        <!-- Nothing selected -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <Image Width="72" Height="72" Opacity="0.9">
                <Image.Source>
                    <BitmapImage UriSource="ms-appx:///Assets/nmmail.png" DecodePixelWidth="72" />
                </Image.Source>
            </Image>
            <TextBlock x:Uid="Reader_Empty" Text="Seleziona un messaggio da leggere" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Multiple selection -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                    Visibility="{x:Bind ViewModel.IsMultiple, Mode=OneWay}">
            <FontIcon Glyph="&#xE8B3;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Click="MultiArchive_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                        <TextBlock x:Uid="Multi_Archive" Text="Archivia" />
                    </StackPanel>
                </Button>
                <Button Click="MultiDelete_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock x:Uid="Multi_Delete" Text="Elimina" />
                    </StackPanel>
                </Button>
                <Button Click="MultiRead_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C3;" FontSize="14" />
                        <TextBlock x:Uid="Multi_MarkRead" Text="Segna come letti" />
                    </StackPanel>
                </Button>
                <Button Click="MultiFlag_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                        <TextBlock x:Uid="Multi_Flag" Text="Contrassegna" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Error -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360"
                    Visibility="{x:Bind ViewModel.IsError, Mode=OneWay}">
            <FontIcon Glyph="&#xE783;" FontSize="36" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <!-- Message -->
        <Grid x:Name="MessagePanel" Visibility="{x:Bind ViewModel.IsMessage, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CommandBar x:Name="Commands" HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="Transparent"
                        IsDynamicOverflowEnabled="True" Margin="8,2,8,0">
                <AppBarButton x:Uid="Reader_Reply" Label="Rispondi" Click="Reply_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8CA;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="Reader_ReplyAll" Label="Rispondi a tutti" Click="ReplyAll_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C2;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="Reader_Forward" Label="Inoltra" Click="Forward_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE89C;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Uid="Reader_Archive" Label="Archivia" Click="Archive_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7B8;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="Reader_Delete" Label="Elimina" Click="Delete_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{x:Bind h:Fmt.ReadToggleLabel(ViewModel.ItemIsUnread), Mode=OneWay}" Click="ToggleRead_Click">
                    <AppBarButton.Icon><FontIcon Glyph="{x:Bind h:Fmt.ReadToggleGlyph(ViewModel.ItemIsUnread), Mode=OneWay}" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarToggleButton x:Uid="Reader_Flag" Label="Contrassegna" IsChecked="{x:Bind ViewModel.ItemIsFlagged, Mode=OneWay}" Click="Flag_Click">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE7C1;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton x:Uid="Reader_Move" Label="Sposta in…">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8DE;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="MoveFlyout" Placement="BottomEdgeAlignedLeft" Opening="MoveFlyout_Opening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>

            <ProgressBar VerticalAlignment="Top" Margin="16,0" IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Header -->
            <Grid Grid.Row="1" Padding="20,6,20,12" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Subject, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40" VerticalAlignment="Top">
                        <Ellipse Fill="{x:Bind ViewModel.AvatarBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Initials, Mode=OneWay}" Foreground="White" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock TextTrimming="CharacterEllipsis" MaxLines="1" IsTextSelectionEnabled="True">
                            <Run Text="{x:Bind ViewModel.FromName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{x:Bind ViewModel.FromAddress, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True">
                            <Run x:Name="ToLabel" Text="A:" />
                            <Run Text="{x:Bind ViewModel.ToText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                                   Visibility="{x:Bind h:Fmt.VisibleIfText(ViewModel.CcText), Mode=OneWay}">
                            <Run x:Name="CcLabel" Text="Cc:" />
                            <Run Text="{x:Bind ViewModel.CcText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DateText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>

            <InfoBar x:Name="RemoteBar" Grid.Row="2" x:Uid="Reader_RemoteBlocked" Margin="16,0,16,8" Severity="Informational"
                     IsClosable="True" Message="Immagini remote bloccate per la tua privacy"
                     IsOpen="{x:Bind ViewModel.ShowRemoteBanner, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Uid="Reader_ShowImages" Content="Mostra immagini" Click="ShowImages_Click"
                            IsEnabled="{x:Bind h:Fmt.Not(ViewModel.IsLoadingRemote), Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Body: always on light paper -->
            <Border x:Name="Paper" Grid.Row="3" Margin="16,0,16,12" CornerRadius="8" Background="{StaticResource PaperBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <WebView2 x:Name="BodyView" DefaultBackgroundColor="White" />
                    <Border x:Name="LinkPreview" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="8,3"
                            CornerRadius="4" Background="#F2F3F3F3" BorderBrush="#33000000" BorderThickness="1" Visibility="Collapsed"
                            IsHitTestVisible="False" MaxWidth="560">
                        <TextBlock x:Name="LinkPreviewText" FontSize="12" Foreground="#FF1B1B1B" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>

            <!-- Attachments -->
            <ScrollViewer Grid.Row="4" Margin="16,0,16,12" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                          Visibility="{x:Bind ViewModel.HasAttachments, Mode=OneWay}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Attachments}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttachmentItem">
                            <Button Padding="10,6" MaxWidth="280" Tag="{x:Bind}" Click="Attachment_Click" ToolTipService.ToolTip="{x:Bind Name}"
                                    AutomationProperties.Name="{x:Bind Name}">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="Attachment_Open" Text="Apri" Tag="{x:Bind}" Click="Attachment_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Attachment_SaveAs" Text="Salva con nome…" Tag="{x:Bind}" Click="AttachmentSaveAs_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource SecondaryCaptionStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
