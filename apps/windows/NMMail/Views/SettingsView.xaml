<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NMMail.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NMMail.ViewModels"
    xmlns:h="using:NMMail.Helpers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="12,4,24,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" x:Uid="Settings_Back" Style="{StaticResource NavigationBackButtonNormalStyle}" Click="Back_Click" />
            <TextBlock Grid.Column="1" x:Uid="Settings_Title" Text="Impostazioni" Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" Margin="4,0,0,0" />
        </Grid>

        <SelectorBar x:Name="Sections" Grid.Row="1" Margin="20,4,20,0" SelectionChanged="Sections_SelectionChanged">
            <SelectorBarItem x:Uid="Settings_SectionAccounts" Text="Account" IsSelected="True">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE77B;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Settings_SectionNotifications" Text="Notifiche">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xEA8F;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Settings_SectionGeneral" Text="Generale">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE790;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Settings_SectionStorage" Text="Archiviazione">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xEDA2;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="OAuth">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE8D7;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Settings_SectionAbout" Text="Informazioni">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE946;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <ScrollViewer Grid.Row="2" Padding="24,0,24,24" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="920" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" Padding="0,8,0,0">

                <!-- ============================== Account -->
                <StackPanel Spacing="4" Visibility="{x:Bind h:Fmt.VisibleIfEqual(ViewModel.SectionIndex, 0), Mode=OneWay}">
                    <TextBlock x:Uid="Settings_AccountsHeader" Text="Account collegati" Style="{StaticResource SettingsSectionTitleStyle}" />
                    <TextBlock x:Uid="Settings_NoAccounts" Text="Nessun account. Aggiungine uno per iniziare a ricevere la posta."
                               Style="{StaticResource SettingsDescriptionTextStyle}" Margin="2,0,0,8"
                               Visibility="{x:Bind h:Fmt.Collapsed(ViewModel.HasAccounts), Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Accounts}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccountSettingsItem">
                                <Grid Style="{StaticResource SettingsCardStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="12" Height="12" Fill="{x:Bind AccountBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Email, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                                        <HyperlinkButton x:Uid="Sidebar_Reauth" Content="Accedi di nuovo" Padding="0,2" FontSize="12"
                                                         Visibility="{x:Bind NeedsReauth, Mode=OneWay}" Tag="{x:Bind}" Click="Reauth_Click" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <ToggleSwitch x:Uid="Settings_AccountNotify" OnContent="Notifiche attive" OffContent="Notifiche disattivate"
                                                      IsOn="{x:Bind Notify, Mode=TwoWay}" />
                                        <CheckBox x:Uid="Settings_GmailPrimary" Content="Notifica solo la scheda Principale"
                                                  IsChecked="{x:Bind PrimaryOnly, Mode=TwoWay}" Visibility="{x:Bind IsGmail, Mode=OneWay}"
                                                  IsEnabled="{x:Bind Notify, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button x:Uid="Settings_RemoveAccount" Grid.Column="3" Style="{StaticResource QuickActionButtonStyle}" Width="36" Height="36"
                                            VerticalAlignment="Center" Tag="{x:Bind}" Click="RemoveAccount_Click">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Grid Style="{StaticResource SettingsCardStyle}" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE710;" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="Settings_AddAccountTitle" Text="Aggiungi un account" Style="{StaticResource SettingsHeaderTextStyle}" />
                            <TextBlock x:Uid="Settings_AddAccountDescription" Text="Gmail e Outlook con accesso sicuro dal browser, oppure qualsiasi server IMAP."
                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                        </StackPanel>
                        <DropDownButton x:Name="AddAccountButton" x:Uid="Settings_AddAccountButton" Grid.Column="2" Content="Aggiungi account"
                                        Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Gmail" Click="AddGmail_Click" />
                                    <MenuFlyoutItem Text="Outlook / Microsoft 365" Click="AddOutlook_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Uid="Settings_AddImap" Text="Altro (IMAP)…" Click="AddImap_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                </StackPanel>

                <!-- ============================== Notifiche -->
                <StackPanel Spacing="4" Visibility="{x:Bind h:Fmt.VisibleIfEqual(ViewModel.SectionIndex, 1), Mode=OneWay}">
                    <TextBlock x:Uid="Settings_NotificationsHeader" Text="Notifiche" Style="{StaticResource SettingsSectionTitleStyle}" />
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="Settings_NotifyEnabled" Text="Mostra una notifica per ogni nuova e-mail" Style="{StaticResource SettingsHeaderTextStyle}" />
                            <TextBlock x:Uid="Settings_NotifyEnabledDescription" Text="Anche quando la finestra di NM Mail è chiusa."
                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Settings_NotifySound" Text="Riproduci un suono" Style="{StaticResource SettingsHeaderTextStyle}" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.NotificationSound, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.NotificationsEnabled, Mode=OneWay}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="Settings_NotifyPreview" Text="Mostra l'anteprima" Style="{StaticResource SettingsHeaderTextStyle}" />
                            <TextBlock x:Uid="Settings_NotifyPreviewDescription" Text="Mittente, oggetto e prime righe del messaggio nella notifica."
                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowPreview, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.NotificationsEnabled, Mode=OneWay}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="Settings_Pause" Text="Sospendi le notifiche" Style="{StaticResource SettingsHeaderTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.QuietText, Mode=OneWay}" Style="{StaticResource SettingsDescriptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Uid="Settings_PauseHour" Content="1 ora" Click="PauseHour_Click" />
                            <Button x:Uid="Settings_PauseTomorrow" Content="Fino a domani" Click="PauseTomorrow_Click" />
                            <Button x:Uid="Settings_Resume" Content="Riprendi" Click="Resume_Click" IsEnabled="{x:Bind ViewModel.IsPaused, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource SettingsCardStyle}" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="Settings_TestTitle" Text="Notifica di prova" Style="{StaticResource SettingsHeaderTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.NotificationTestStatus, Mode=OneWay}" Style="{StaticResource SettingsDescriptionTextStyle}"
                                       Visibility="{x:Bind h:Fmt.VisibleIfText(ViewModel.NotificationTestStatus), Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="Settings_TestButton" Content="Invia notifica di prova" VerticalAlignment="Center"
                                Click="TestNotification_Click" IsEnabled="{x:Bind h:Fmt.Not(ViewModel.IsTestingNotification), Mode=OneWay}" />
                        <InfoBar Grid.Row="1" Grid.ColumnSpan="2" x:Uid="Settings_NotificationsDisabled" Severity="Warning" IsClosable="False"
                                 Title="Le notifiche di NM Mail sono disattivate in Windows"
                                 Message="Attivale in Impostazioni di Windows → Sistema → Notifiche."
                                 IsOpen="{x:Bind ViewModel.ShowNotificationsDisabledHint, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <HyperlinkButton x:Uid="Settings_OpenNotificationSettings" Content="Apri impostazioni notifiche" Click="OpenNotificationSettings_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </Grid>
                </StackPanel>

                <!-- ============================== Generale -->
                <StackPanel Spacing="4" Visibility="{x:Bind h:Fmt.VisibleIfEqual(ViewModel.SectionIndex, 2), Mode=OneWay}">
                    <TextBlock x:Uid="Settings_GeneralHeader" Text="Generale" Style="{StaticResource SettingsSectionTitleStyle}" />
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="Settings_Autostart" Text="Avvia NM Mail all'accesso a Windows" Style="{StaticResource SettingsHeaderTextStyle}" />
                            <TextBlock x:Uid="Settings_AutostartDescription" Text="Il servizio in background (pochi MB) riceve le e-mail e mostra le notifiche anche a finestra chiusa."
                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Autostart, Mode=TwoWay}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Settings_Theme" Text="Tema" Style="{StaticResource SettingsHeaderTextStyle}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_ThemeSystem" Content="Usa le impostazioni di sistema" />
                            <ComboBoxItem x:Uid="Settings_ThemeLight" Content="Chiaro" />
                            <ComboBoxItem x:Uid="Settings_ThemeDark" Content="Scuro" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource SettingsCardStyle}" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="Settings_Language" Text="Lingua" Style="{StaticResource SettingsHeaderTextStyle}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_LanguageSystem" Content="Lingua di Windows" />
                            <ComboBoxItem Content="Italiano" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                        <InfoBar Grid.Row="1" Grid.ColumnSpan="2" x:Uid="Settings_LanguageRestart" Severity="Informational" IsClosable="False"
                                 Message="La nuova lingua verrà applicata al prossimo avvio di NM Mail."
                                 IsOpen="{x:Bind ViewModel.ShowLanguageRestartHint, Mode=OneWay}" />
                    </Grid>
                </StackPanel>

                <!-- ============================== Archiviazione -->
                <StackPanel Spacing="4" Visibility="{x:Bind h:Fmt.VisibleIfEqual(ViewModel.SectionIndex, 3), Mode=OneWay}">
                    <TextBlock x:Uid="Settings_StorageHeader" Text="Archiviazione" Style="{StaticResource SettingsSectionTitleStyle}" />
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="Settings_CacheDays" Text="Conserva sul PC le e-mail degli ultimi" Style="{StaticResource SettingsHeaderTextStyle}" />
                            <TextBlock x:Uid="Settings_CacheDaysDescription" Text="Le e-mail più vecchie restano sul server e vengono scaricate solo quando scorri fino a loro."
                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.CacheDaysIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_Cache30" Content="30 giorni" />
                            <ComboBoxItem x:Uid="Settings_Cache90" Content="90 giorni" />
                            <ComboBoxItem x:Uid="Settings_Cache180" Content="180 giorni" />
                            <ComboBoxItem x:Uid="Settings_Cache365" Content="1 anno" />
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <!-- ============================== OAuth -->
                <StackPanel Spacing="4" Visibility="{x:Bind h:Fmt.VisibleIfEqual(ViewModel.SectionIndex, 4), Mode=OneWay}">
                    <TextBlock x:Uid="Settings_OAuthHeader" Text="Credenziali OAuth" Style="{StaticResource SettingsSectionTitleStyle}" />
                    <TextBlock x:Uid="Settings_OAuthDescription" Style="{StaticResource SettingsDescriptionTextStyle}" Margin="2,0,0,8"
                               Text="Per collegare Gmail e Outlook, NM Mail usa un'app OAuth registrata da te (gratuita, nessun server di terze parti). Segui la guida passo-passo in docs/OAUTH_SETUP.md e incolla qui gli identificativi." />
                    <Grid Style="{StaticResource SettingsCardStyle}" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Google (Gmail)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBox Grid.Row="1" x:Uid="Settings_GoogleClientId" Header="Client ID" Text="{x:Bind ViewModel.GoogleClientId, Mode=TwoWay}"
                                 PlaceholderText="1234567890-abc.apps.googleusercontent.com" IsSpellCheckEnabled="False" />
                        <PasswordBox Grid.Row="2" x:Uid="Settings_GoogleClientSecret" Header="Client secret" Password="{x:Bind ViewModel.GoogleClientSecret, Mode=TwoWay}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsCardStyle}" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Microsoft (Outlook, Microsoft 365)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBox Grid.Row="1" x:Uid="Settings_MicrosoftClientId" Header="Client ID (Application ID)" Text="{x:Bind ViewModel.MicrosoftClientId, Mode=TwoWay}"
                                 PlaceholderText="00000000-0000-0000-0000-000000000000" IsSpellCheckEnabled="False" />
                    </Grid>
                    <Button x:Uid="Settings_SaveOAuth" Content="Salva" Style="{StaticResource AccentButtonStyle}" Margin="0,8,0,0" Click="SaveOAuth_Click" />
                </StackPanel>

                <!-- ============================== Informazioni -->
                <StackPanel Spacing="4" Visibility="{x:Bind h:Fmt.VisibleIfEqual(ViewModel.SectionIndex, 5), Mode=OneWay}">
                    <TextBlock x:Uid="Settings_AboutHeader" Text="Informazioni" Style="{StaticResource SettingsSectionTitleStyle}" />
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="40" Height="40">
                            <Image.Source>
                                <BitmapImage UriSource="ms-appx:///Assets/nmmail.png" DecodePixelWidth="40" />
                            </Image.Source>
                        </Image>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="NM Mail — Never Miss Mail" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SettingsDescriptionTextStyle}">
                                <Run x:Name="VersionLabel" Text="Versione" />
                                <Run Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource SettingsCardStyle}" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="Settings_DaemonTitle" Grid.ColumnSpan="2" Text="Servizio in background (nmmaild)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button Grid.Column="2" x:Uid="Settings_Refresh" Style="{StaticResource QuickActionButtonStyle}" Width="34" Height="34" Click="RefreshStatus_Click">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <TextBlock Grid.Row="1" x:Uid="Settings_DaemonVersion" Text="Versione" Style="{StaticResource SettingsDescriptionTextStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DaemonVersion, Mode=OneWay}" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="2" x:Uid="Settings_DaemonPid" Text="PID" Style="{StaticResource SettingsDescriptionTextStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DaemonPid, Mode=OneWay}" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="3" x:Uid="Settings_DaemonUptime" Text="Attivo da" Style="{StaticResource SettingsDescriptionTextStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.DaemonUptime, Mode=OneWay}" />
                        <TextBlock Grid.Row="4" x:Uid="Settings_DaemonMemory" Text="Memoria" Style="{StaticResource SettingsDescriptionTextStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.DaemonMemory, Mode=OneWay}" />
                        <TextBlock Grid.Row="5" x:Uid="Settings_UiMemory" Text="Memoria finestra (questa app)" Style="{StaticResource SettingsDescriptionTextStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.UiMemory, Mode=OneWay}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="Settings_Shutdown" Text="Arresta il servizio in background" Style="{StaticResource SettingsHeaderTextStyle}" />
                            <TextBlock x:Uid="Settings_ShutdownDescription" Text="Le nuove e-mail non verranno più notificate finché NM Mail non viene riaperto."
                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="Settings_ShutdownButton" Content="Arresta" VerticalAlignment="Center" Click="Shutdown_Click" />
                    </Grid>
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
