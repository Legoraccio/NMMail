<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NMMail.Views.ComposeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NMMail.ViewModels"
    xmlns:models="using:NMMail.Models"
    xmlns:h="using:NMMail.Helpers">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <DataTemplate x:Key="ContactTemplate" x:DataType="models:Addr">
                <StackPanel Padding="0,4">
                    <TextBlock Text="{x:Bind DisplayName}" />
                    <TextBlock Text="{x:Bind Address}" Style="{StaticResource SecondaryCaptionStyle}" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Enter" Invoked="SendAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="ComposeTitleBar" Title="{x:Bind ViewModel.WindowTitle, Mode=OneWay}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/nmmail.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Commands -->
        <Grid Grid.Row="1" Padding="16,2,16,8" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SendButton" x:Uid="Compose_SendButton" Style="{StaticResource AccentButtonStyle}" Padding="14,6"
                    Click="Send_Click" IsEnabled="{x:Bind h:Fmt.Not(ViewModel.IsBusy), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                    <TextBlock x:Uid="Compose_Send" Text="Invia" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Uid="Compose_AttachButton" Click="Attach_Click" Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE723;" FontSize="14" />
                    <TextBlock x:Uid="Compose_Attach" Text="Allega" />
                </StackPanel>
            </Button>
            <Rectangle Grid.Column="2" Width="1" Height="22" Margin="6,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                <Button x:Uid="Compose_Bold" Style="{StaticResource QuickActionButtonStyle}" Width="34" Height="32" Tag="bold" Click="Format_Click">
                    <FontIcon Glyph="&#xE8DD;" FontSize="14" />
                </Button>
                <Button x:Uid="Compose_Italic" Style="{StaticResource QuickActionButtonStyle}" Width="34" Height="32" Tag="italic" Click="Format_Click">
                    <FontIcon Glyph="&#xE8DB;" FontSize="14" />
                </Button>
                <Button x:Uid="Compose_Underline" Style="{StaticResource QuickActionButtonStyle}" Width="34" Height="32" Tag="underline" Click="Format_Click">
                    <FontIcon Glyph="&#xE8DC;" FontSize="14" />
                </Button>
                <Button x:Uid="Compose_Bullets" Style="{StaticResource QuickActionButtonStyle}" Width="34" Height="32" Tag="insertUnorderedList" Click="Format_Click">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                </Button>
                <Button x:Uid="Compose_Numbering" Style="{StaticResource QuickActionButtonStyle}" Width="34" Height="32" Tag="insertOrderedList" Click="Format_Click">
                    <TextBlock Text="1." FontSize="13" FontWeight="SemiBold" />
                </Button>
                <Button x:Uid="Compose_Link" Style="{StaticResource QuickActionButtonStyle}" Width="34" Height="32" Click="Link_Click">
                    <FontIcon Glyph="&#xE71B;" FontSize="14" />
                </Button>
                <Button x:Uid="Compose_ClearFormatting" Style="{StaticResource QuickActionButtonStyle}" Width="34" Height="32" Click="ClearFormatting_Click">
                    <FontIcon Glyph="&#xED62;" FontSize="14" />
                </Button>
            </StackPanel>
            <ProgressRing Grid.Column="4" Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>

        <!-- Header fields -->
        <Grid Grid.Row="2" Padding="16,0,16,8" ColumnSpacing="12" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Uid="Compose_From" Text="Da" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="FromBox" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.Accounts}" SelectedIndex="{x:Bind ViewModel.FromIndex, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Account">
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind DisplayName}" />
                            <Run Text="{x:Bind Email}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="1" x:Uid="Compose_To" Text="A" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <AutoSuggestBox x:Name="ToBox" Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.To, Mode=TwoWay}"
                            ItemsSource="{x:Bind ViewModel.Suggestions}" UpdateTextOnSelect="False"
                            TextChanged="Recipient_TextChanged" QuerySubmitted="Recipient_QuerySubmitted" ItemTemplate="{StaticResource ContactTemplate}" />
            <HyperlinkButton Grid.Row="1" Grid.Column="2" x:Uid="Compose_ShowCcBcc" Content="Cc/Ccn" Click="ShowCcBcc_Click"
                             Visibility="{x:Bind h:Fmt.Collapsed(ViewModel.ShowCcBcc), Mode=OneWay}" />

            <TextBlock Grid.Row="2" Text="Cc" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind ViewModel.ShowCcBcc, Mode=OneWay}" />
            <AutoSuggestBox x:Name="CcBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.Cc, Mode=TwoWay}"
                            ItemsSource="{x:Bind ViewModel.Suggestions}" UpdateTextOnSelect="False" Visibility="{x:Bind ViewModel.ShowCcBcc, Mode=OneWay}"
                            TextChanged="Recipient_TextChanged" QuerySubmitted="Recipient_QuerySubmitted" ItemTemplate="{StaticResource ContactTemplate}" />

            <TextBlock Grid.Row="3" x:Uid="Compose_Bcc" Text="Ccn" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind ViewModel.ShowCcBcc, Mode=OneWay}" />
            <AutoSuggestBox x:Name="BccBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.Bcc, Mode=TwoWay}"
                            ItemsSource="{x:Bind ViewModel.Suggestions}" UpdateTextOnSelect="False" Visibility="{x:Bind ViewModel.ShowCcBcc, Mode=OneWay}"
                            TextChanged="Recipient_TextChanged" QuerySubmitted="Recipient_QuerySubmitted" ItemTemplate="{StaticResource ContactTemplate}" />

            <TextBlock Grid.Row="4" x:Uid="Compose_Subject" Text="Oggetto" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="SubjectBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                     Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <InfoBar Grid.Row="3" Margin="16,0,16,8" Severity="Error" IsClosable="True"
                 IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <!-- Attachments -->
        <ScrollViewer Grid.Row="4" Margin="16,0,16,8" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                      Visibility="{x:Bind ViewModel.HasAttachments, Mode=OneWay}">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Attachments}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComposeAttachmentItem">
                        <Border CornerRadius="4" Padding="8,4,4,4" BorderThickness="1" AutomationProperties.Name="{x:Bind Name}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource SecondaryCaptionStyle}" />
                                </StackPanel>
                                <Button x:Uid="Compose_RemoveAttachment" Style="{StaticResource QuickActionButtonStyle}" Width="26" Height="26"
                                        VerticalAlignment="Center" Tag="{x:Bind}" Click="RemoveAttachment_Click">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Editor: our own contenteditable page in WebView2 -->
        <Border Grid.Row="5" Margin="16,0,16,16" CornerRadius="8" Background="{StaticResource PaperBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <WebView2 x:Name="Editor" DefaultBackgroundColor="White" />
        </Border>
    </Grid>
</Window>
