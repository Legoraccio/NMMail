<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NMMail.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NMMail.Views"
    xmlns:controls="using:NMMail.Controls"
    xmlns:h="using:NMMail.Helpers">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="R" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="F" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Delete" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Back" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="E" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Q" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="U" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="Accelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Custom title bar: icon, name, search -->
        <TitleBar x:Name="AppTitleBar" Title="NM Mail" IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/nmmail.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="SearchBox" x:Uid="SearchBox" PlaceholderText="Cerca nella posta" QueryIcon="Find"
                                MinWidth="280" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button x:Name="SyncButton" x:Uid="TitleBar_Sync" Style="{StaticResource QuickActionButtonStyle}" Width="40" Height="34"
                        Margin="0,0,4,0" Click="Sync_Click">
                    <FontIcon Glyph="&#xE895;" FontSize="15" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Non-blocking banners -->
        <StackPanel Grid.Row="1">
            <InfoBar x:Name="ConnectionBar" x:Uid="ConnectionBar" Severity="Warning" IsClosable="False" Margin="12,0,12,6"
                     Message="Servizio NM Mail non raggiungibile, riconnessione…"
                     IsOpen="{x:Bind ViewModel.ShowReconnectBanner, Mode=OneWay}">
                <InfoBar.Content>
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.ShowReconnectBanner, Mode=OneWay}" Margin="0,0,0,6" />
                </InfoBar.Content>
            </InfoBar>
            <InfoBar x:Name="NoticeBar" IsClosable="True" Margin="12,0,12,6"
                     IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                     Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" />
        </StackPanel>

        <!-- Three panes -->
        <Grid x:Name="MailGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="264" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ListColumn" Width="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <views:SidebarView x:Name="Sidebar" Grid.Column="0" />
            <controls:PaneSplitter x:Name="SidebarSplitter" Grid.Column="1" />

            <Border Grid.Column="2" Grid.ColumnSpan="3" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
            <views:MessageListView x:Name="MessageListPane" Grid.Column="2" />
            <controls:PaneSplitter x:Name="ListSplitter" Grid.Column="3" />
            <Border Grid.Column="3" Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    IsHitTestVisible="False" />
            <views:ReaderView x:Name="Reader" Grid.Column="4" />
        </Grid>

        <!-- Settings: the view is created on first use (keeps startup light) -->
        <Grid x:Name="SettingsHost" Grid.Row="2" Visibility="Collapsed"
              Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0" />

    </Grid>
</Window>
